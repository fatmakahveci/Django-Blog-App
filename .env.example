# Local development only. start.py creates .env and a private key automatically.
# Manual setup: copy to .env, append a generated secret, then source it.
# Production: leave DJANGO_DEBUG unset (or false) and use your actual hostnames.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DJANGO_SECRET_KEY must be generated separately; see README.md.
